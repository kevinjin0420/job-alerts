{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DashboardRoleProvision",
      "Effect": "Allow",
      "Action": ["iam:GetRole", "iam:CreateRole", "iam:PutRolePolicy", "iam:GetRolePolicy"],
      "Resource": "arn:aws:iam::863516093571:role/job-alerts-dashboard-role"
    },
    {
      "Sid": "PassDashboardRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::863516093571:role/job-alerts-dashboard-role"
    },
    {
      "Sid": "DashboardFunctionProvision",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:CreateFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:GetPolicy",
        "lambda:CreateFunctionUrlConfig",
        "lambda:UpdateFunctionUrlConfig",
        "lambda:GetFunctionUrlConfig",
        "lambda:DeleteFunctionUrlConfig"
      ],
      "Resource": "arn:aws:lambda:us-west-1:863516093571:function:job-alerts-dashboard"
    },
    {
      "Sid": "DashboardApiGatewayProvision",
      "Effect": "Allow",
      "Action": ["apigateway:GET", "apigateway:POST", "apigateway:PATCH", "apigateway:DELETE", "apigateway:PUT"],
      "Resource": [
        "arn:aws:apigateway:us-west-1::/apis",
        "arn:aws:apigateway:us-west-1::/apis/*"
      ]
    }
  ]
}
