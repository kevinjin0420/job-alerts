{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UserPoolProvision",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:CreateUserPool",
        "cognito-idp:DescribeUserPool",
        "cognito-idp:UpdateUserPool",
        "cognito-idp:CreateUserPoolClient",
        "cognito-idp:DescribeUserPoolClient"
      ],
      "Resource": "*"
    },
    {
      "Sid": "UserAdmin",
      "Effect": "Allow",
      "Action": ["cognito-idp:AdminCreateUser", "cognito-idp:AdminDeleteUser", "cognito-idp:AdminGetUser", "cognito-idp:ListUsers"],
      "Resource": "arn:aws:cognito-idp:us-west-1:863516093571:userpool/us-west-1_eEd1CGYWQ"
    }
  ]
}
