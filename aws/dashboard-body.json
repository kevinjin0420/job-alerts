{
  "widgets": [
    {
      "type": "metric",
      "x": 0, "y": 0, "width": 12, "height": 6,
      "properties": {
        "title": "Pipeline Health (also shows cron gaps = time since last scan)",
        "region": "us-west-1",
        "view": "timeSeries",
        "period": 300,
        "metrics": [
          ["AWS/Lambda", "Invocations", "FunctionName", "job-alerts-watch", { "stat": "Sum" }],
          ["AWS/Lambda", "Errors", "FunctionName", "job-alerts-watch", { "stat": "Sum" }],
          ["AWS/Lambda", "Duration", "FunctionName", "job-alerts-watch", { "stat": "Average", "yAxis": "right" }]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12, "y": 0, "width": 12, "height": 6,
      "properties": {
        "title": "Notifications & Failures",
        "region": "us-west-1",
        "view": "timeSeries",
        "period": 300,
        "metrics": [
          ["job-alerts", "NotificationsSent", { "stat": "Sum" }],
          ["job-alerts", "NotificationFailures", { "stat": "Sum" }],
          ["job-alerts", "SourceFetchFailures", { "stat": "Sum" }]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0, "y": 6, "width": 12, "height": 6,
      "properties": {
        "title": "Classifier Token Usage (avg per call)",
        "region": "us-west-1",
        "view": "timeSeries",
        "period": 300,
        "metrics": [
          ["job-alerts", "ClassifierInputTokens", { "stat": "Average" }],
          ["job-alerts", "ClassifierOutputTokens", { "stat": "Average" }]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12, "y": 6, "width": 12, "height": 6,
      "properties": {
        "title": "Classifier Calls Today",
        "region": "us-west-1",
        "view": "singleValue",
        "period": 86400,
        "metrics": [
          ["job-alerts", "ClassifierCalls", { "stat": "Sum" }],
          ["job-alerts", "NotificationsSent", { "stat": "Sum" }],
          ["job-alerts", "SourceFetchFailures", { "stat": "Sum" }]
        ]
      }
    }
  ]
}
