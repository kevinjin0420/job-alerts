{
  "widgets": [
    {
      "type": "metric",
      "x": 0, "y": 0, "width": 12, "height": 6,
      "properties": {
        "title": "Invocations (did it run on time - gaps = missed runs)",
        "region": "us-west-1",
        "view": "timeSeries",
        "period": 60,
        "metrics": [
          ["AWS/Lambda", "Invocations", "FunctionName", "job-alerts-watch", { "stat": "Sum" }]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12, "y": 0, "width": 12, "height": 6,
      "properties": {
        "title": "Duration",
        "region": "us-west-1",
        "view": "timeSeries",
        "period": 60,
        "metrics": [
          ["AWS/Lambda", "Duration", "FunctionName", "job-alerts-watch", { "stat": "Average" }]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0, "y": 6, "width": 12, "height": 6,
      "properties": {
        "title": "Success / Error Rate",
        "region": "us-west-1",
        "view": "pie",
        "setPeriodToTimeRange": true,
        "metrics": [
          [{ "expression": "m1 - m2", "label": "Success", "id": "e1" }],
          ["AWS/Lambda", "Invocations", "FunctionName", "job-alerts-watch", { "id": "m1", "visible": false, "stat": "Sum" }],
          ["AWS/Lambda", "Errors", "FunctionName", "job-alerts-watch", { "id": "m2", "stat": "Sum", "label": "Errors" }]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12, "y": 6, "width": 12, "height": 6,
      "properties": {
        "title": "Failures",
        "region": "us-west-1",
        "view": "bar",
        "period": 300,
        "metrics": [
          ["job-alerts", "NotificationFailures", { "stat": "Sum" }],
          ["job-alerts", "SourceFetchFailures", { "stat": "Sum" }]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0, "y": 12, "width": 6, "height": 6,
      "properties": {
        "title": "Notifications Sent",
        "region": "us-west-1",
        "view": "singleValue",
        "setPeriodToTimeRange": true,
        "metrics": [
          ["job-alerts", "NotificationsSent", { "stat": "Sum" }]
        ]
      }
    },
    {
      "type": "metric",
      "x": 6, "y": 12, "width": 6, "height": 6,
      "properties": {
        "title": "Classifier Calls",
        "region": "us-west-1",
        "view": "singleValue",
        "setPeriodToTimeRange": true,
        "metrics": [
          ["job-alerts", "ClassifierCalls", { "stat": "Sum" }]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12, "y": 12, "width": 12, "height": 6,
      "properties": {
        "title": "Classifier Token Usage (avg per call)",
        "region": "us-west-1",
        "view": "timeSeries",
        "period": 300,
        "metrics": [
          ["job-alerts", "ClassifierInputTokens", { "stat": "Average" }],
          ["job-alerts", "ClassifierOutputTokens", { "stat": "Average" }]
        ]
      }
    }
  ]
}
